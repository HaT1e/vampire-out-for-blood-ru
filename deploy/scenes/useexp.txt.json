1)))) #Бой. (Текущий уровень: ${combat}, стоимость повышения: ${3 * (combat +1)}) Отражает умение драться врукопашную, защищаться, владеть оружием ближнего боя и огнестрельным оружием.","          *set exp -(3 * (combat +1))","          Вы повышаете Бой с ${combat} до","          *set combat +1","          ${combat}.","          ","          *goto SelectImprovement","        *allow_reuse *selectable_if ((faith < 5) and (exp >= (3 * (faith +1)))) #Вера. (Текущий уровень: ${faith}, стоимость повышения: ${3 * (faith +1)}) Означает вашу связь с высшей силой. Чем выше уровень, тем лучше вы чувствуете и отпугиваете нежить и даже творите чудеса.","          *set exp -(3 * (faith +1))","          Вы повышаете Веру с ${faith} до","          *set faith +1","          ${faith}.","          ","          *goto SelectImprovement","        *allow_reuse *selectable_if ((insight < 5) and (exp >= (3 * (insight +1)))) #Проницательность. (Текущий уровень: ${insight}, стоимость повышения: ${3 * (insight +1)}) Способность читать язык тела и выражения лиц, чтобы понимать эмоции, искренность и мотивы других.","          *set exp -(3 * (insight +1))","          Вы повышаете Проницательность с ${insight} до","          *set insight +1","          ${insight}.","          ","          *goto SelectImprovement","        *allow_reuse *selectable_if ((intimidation < 5) and (exp >= (3 * (intimidation +1)))) #Запугивание. (Текущий уровень: ${intimidation}, стоимость повышения: ${3 * (intimidation +1)}) Определяет умение принуждать физически и словесно. Чем выше уровень, тем легче вам подчинить кого-либо.","          *set exp -(3 * (intimidation +1))","          Вы повышаете Запугивание с ${intimidation} до","          *set intimidation +1","          ${intimidation}.","          ","          *goto SelectImprovement","        *allow_reuse *selectable_if ((investigation < 5) and (exp >= (3 * (investigation +1)))) #Расследование. (Текущий уровень: ${investigation}, стоимость повышения: ${3 * (investigation +1)}) Позволяет находить улики, разгадывать загадки и изучать интересующие вас вещи.","          *set exp -(3 * (investigation +1))","          Вы повышаете Расследование с ${investigation} до","          *set investigation +1","          ${investigation}.","          ","          *goto SelectImprovement","        *allow_reuse *selectable_if ((clandestine < 5) and (exp >= (3 * (clandestine +1)))) #Скрытность. (Текущий уровень: ${clandestine}, стоимость повышения: ${3 * (clandestine +1)}) Знание инструментов и приёмов для проникновения в дома, вскрытия замков, карманных краж, скрытного передвижения, угона автомобилей и других воровских уловок.","          *set exp -(3 * (clandestine +1))","          Вы повышаете Скрытность с ${clandestine} до","          *set clandestine +1","          ${clandestine}.","          ","          *goto SelectImprovement","        *allow_reuse *selectable_if ((leadership < 5) and (exp >= (3 * (leadership +1)))) #Лидерство. (Текущий уровень: ${leadership}, стоимость повышения: ${3 * (leadership +1)}) Позволяет вдохновлять других, управлять толпой и вести группу в бой.","          *set exp -(3 * (leadership +1))","          Вы повышаете Лидерство с ${leadership} до","          *set leadership +1","          ${leadership}.","          ","          *goto SelectImprovement","        *allow_reuse *selectable_if ((occult < 5) and (exp >= (3 * (occult +1)))) #Оккультизм. (Текущий уровень: ${occult}, стоимость повышения: ${3 * (occult +1)}) Отражает знания о сверхъестественном мире. Чем выше уровень, тем лучше вы заглядываете в будущее и накладываете проклятия.","          *set exp -(3 * (occult +1))","          Вы повышаете Оккультизм с ${occult} до","          *set occult +1","          ${occult}.","          ","          *goto SelectImprovement","        *allow_reuse *selectable_if ((persuasion < 5) and (exp >= (3 * (persuasion +1)))) #Убеждение. (Текущий уровень: ${persuasion}, стоимость повышения: ${3 * (persuasion +1)}) Позволяет скрытно влиять на людей при личном контакте с помощью слов или жестов.","          *set exp -(3 * (persuasion +1))","          Вы повышаете Убеждение с ${persuasion} до","          *set persuasion +1","          ${persuasion}.","          ","          *goto SelectImprovement","        *allow_reuse *selectable_if ((science < 5) and (exp >= (3 * (science +1)))) #Наука и техника. (Текущий уровень: ${science}, стоимость повышения: ${3 * (science +1)}) Определяет знания и навыки в химии, физике и биологии, а также умение обращаться с современными технологиями.","          *set exp -(3 * (science +1))","          Вы повышаете Науку и технику с ${science} до","          *set science +1","          ${science}.","          ","          *goto SelectImprovement","        *allow_reuse *selectable_if ((subterfuge < 5) and (exp >= (3 * (subterfuge +1)))) #Хитрость. (Текущий уровень: ${subterfuge}, стоимость повышения: ${3 * (subterfuge +1)}) Отражает способность обманывать и хранить секреты даже под давлением.","          *set exp -(3 * (subterfuge +1))","          Вы повышаете Хитрость с ${subterfuge} до","          *set subterfuge +1","          ${subterfuge}.","          ","          *goto SelectImprovement","        *allow_reuse *selectable_if ((survival < 5) and (exp >= (3 * (survival +1)))) #Выживание. (Текущий уровень: ${survival}, стоимость повышения: ${3 * (survival +1)}) Даёт умение ориентироваться на природе, выслеживать других в лесу и прятаться в дикой местности.","          *set exp -(3 * (survival +1))","          Вы повышаете Выживание с ${survival} до","          *set survival +1","          ${survival}.","          ","          *goto SelectImprovement","        *allow_reuse #Вернуться в главное меню.","          *goto SelectImprovement","    *allow_reuse #Связи.","      *text_image backgrounds.jpg","","      *gosub CalcDots contacts 5","      Контакты: ${show_score}","      *line_break","      *gosub CalcDots influence 5","      Влияние: ${show_score}","      *line_br